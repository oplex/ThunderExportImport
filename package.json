{
  "name": "thunderexportimport",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ThunderExportImport: export Thunderbird mail to EML, MBOX, HTML, PDF and ZIP, and import it back",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check-lines": "node scripts/check-lines.mjs",
    "check-kit": "node scripts/kit.mjs check",
    "lint": "npx --yes web-ext@8.3.0 lint --self-hosted --ignore-files 'test/**' 'scripts/**' 'dist/**' 'listing/**' 'package.json' '*.md'",
    "build": "sh scripts/build.sh",
    "release": "sh scripts/release.sh",
    "test:tb": "TB_BIN=${TB_BIN:-$(sh scripts/fetch-thunderbird.sh)} node test/integration/run.mjs"
  },
  "license": "MIT",
  "author": "oplex.se"
}
